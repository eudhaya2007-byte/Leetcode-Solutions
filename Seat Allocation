class Solution {
public:
    int maxNumberOfFamilies(int n, vector<vector<int>>& reservedSeats) {
        unordered_map<int, int> reserved;

        // Store only seats that affect the three possible blocks.
        for (auto &seat : reservedSeats) {
            int row = seat[0];
            int col = seat[1];

            if (col >= 2 && col <= 9) {
                reserved[row] |= (1 << col);
            }
        }

        // Every completely empty row can fit 2 groups.
        long long ans = 2LL * (n - reserved.size());

        for (auto &[row, mask] : reserved) {
            bool left  = !(mask & ((1 << 2) | (1 << 3) | (1 << 4) | (1 << 5)));
            bool right = !(mask & ((1 << 6) | (1 << 7) | (1 << 8) | (1 << 9)));
            bool mid   = !(mask & ((1 << 4) | (1 << 5) | (1 << 6) | (1 << 7)));

            if (left && right) {
                ans += 2;
            } 
            else if (left || mid || right) {
                ans += 1;
            }
        }

        return (int)ans;
    }
};
