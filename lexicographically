class Solution {
public:
    string lexGreaterPermutation(string s, string target) {
        int n = s.size();

        
        vector<array<int, 26>> cnt(n + 1);

        for (int c = 0; c < 26; c++)
            cnt[0][c] = 0;

        for (char ch : s)
            cnt[0][ch - 'a']++;

        
        for (int i = 0; i < n; i++) {
            cnt[i + 1] = cnt[i];

            int x = target[i] - 'a';

            if (cnt[i + 1][x] > 0)
                cnt[i + 1][x]--;
            else {
                
                for (int c = 0; c < 26; c++)
                    cnt[i + 1][c] = -1;
            }
        }

        
        for (int i = n - 1; i >= 0; i--) {
            bool valid = true;

            for (int c = 0; c < 26; c++) {
                if (cnt[i][c] < 0) {
                    valid = false;
                    break;
                }
            }

            if (!valid)
                continue;

            int cur = target[i] - 'a';

            
            for (int c = cur + 1; c < 26; c++) {
                if (cnt[i][c] > 0) {
                    string ans = target.substr(0, i);

                    
                    ans += char('a' + c);

                    
                    auto remaining = cnt[i];
                    remaining[c]--;

                    
                    for (int x = 0; x < 26; x++) {
                        while (remaining[x] > 0) {
                            ans += char('a' + x);
                            remaining[x]--;
                        }
                    }

                    return ans;
                }
            }
        }

        return "";
    }
};
