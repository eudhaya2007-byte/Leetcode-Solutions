class Solution {
public:
    long long findKthSmallest(vector<int>& coins, int k) {
        // Remove redundant coins:
        // If a coin is divisible by another coin, its multiples
        // are already generated by the smaller coin.
        sort(coins.begin(), coins.end());

        vector<int> useful;
        for (int c : coins) {
            bool redundant = false;
            for (int x : useful) {
                if (c % x == 0) {
                    redundant = true;
                    break;
                }
            }
            if (!redundant)
                useful.push_back(c);
        }

        int n = useful.size();

        // Count how many distinct positive amounts <= x
        // are divisible by at least one coin.
        auto count = [&](long long x) -> long long {
            long long result = 0;

            // Inclusion-Exclusion
            for (int mask = 1; mask < (1 << n); ++mask) {
                long long lcm = 1;
                int bits = 0;
                bool overflow = false;

                for (int i = 0; i < n; ++i) {
                    if (mask & (1 << i)) {
                        ++bits;

                        long long g = std::gcd(lcm, (long long)useful[i]);

                        // Avoid overflow while calculating LCM
                        lcm = lcm / g * useful[i];

                        if (lcm > x) {
                            overflow = true;
                            break;
                        }
                    }
                }

                if (overflow || lcm > x)
                    continue;

                long long cnt = x / lcm;

                if (bits & 1)
                    result += cnt;
                else
                    result -= cnt;
            }

            return result;
        };

        // Binary search for the smallest amount
        // having at least k distinct obtainable amounts.
        long long left = 1;
        long long right = 1LL * (*min_element(useful.begin(), useful.end())) * k;

        while (left < right) {
            long long mid = left + (right - left) / 2;

            if (count(mid) >= k)
                right = mid;
            else
                left = mid + 1;
        }

        return left;
    }
};
