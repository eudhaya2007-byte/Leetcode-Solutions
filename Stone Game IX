class Solution {
public:
    bool stoneGameIX(vector<int>& stones) {
        int cnt[3] = {};

        for (int x : stones)
            cnt[x % 3]++;

        // Stones divisible by 3 can only be used safely when
        // the current sum is not 0. Their exact count matters by parity.
        if (cnt[0] % 2 == 0) {
            return cnt[1] > 0 && cnt[2] > 0;
        }

        // cnt[0] is odd
        return abs(cnt[1] - cnt[2]) > 2;
    }
};
